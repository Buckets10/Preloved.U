        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/programs",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "programs"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response berupa JSON\", function () { pm.response.to.be.json; });"
            ]
          }
        }
      ]
